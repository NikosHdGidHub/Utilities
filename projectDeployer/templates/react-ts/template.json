{
  "version": 1,
  "id": "react-ts",
  "name": "React Basic",
  "description": "React, TypeScript и Vite. Компоненты и адаптивные стили на CSS.",
  "stages": {
    "Scaffold": [
      {
        "label": "Создание React + TypeScript",
        "args": [
          "npm",
          "exec",
          "--yes",
          "--engine-strict",
          "--package=create-vite@9",
          "--",
          "create-vite",
          ".",
          "--template",
          "react-ts",
          "--no-interactive",
          "--no-immediate"
        ]
      },
      {
        "label": "Имя пакета",
        "args": [
          "npm",
          "pkg",
          "set",
          "name={{package_name}}"
        ]
      }
    ],
    "Dependencies": [
      {
        "label": "Установка зависимостей",
        "args": [
          "npm",
          "install",
          "--engine-strict",
          "--strict-peer-deps",
          "--no-fund"
        ]
      }
    ]
  },
  "remove": [
    "src/App.css",
    "src/assets",
    "public"
  ]
}
